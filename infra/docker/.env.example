TLS_EMAIL=admin@example.com
OR_HOSTNAME=ems.gridex.tech
OR_ADDITIONAL_HOSTNAMES=
OR_ADMIN_PASSWORD=replace-with-a-long-random-password
OR_SETUP_TYPE=
OR_SETUP_RUN_ON_RESTART=false
OR_METRICS_ENABLED=true

GRIDEX_REALM=gridex
GRIDEX_OIDC_AUDIENCE=gridex-api
GRIDEX_POSTGRES_VERSION=17-alpine
GRIDEX_POSTGRES_DB=gridex
GRIDEX_POSTGRES_USER=gridex_app
GRIDEX_POSTGRES_PASSWORD=replace-with-a-different-long-random-password
GRIDEX_DATABASE_POOL_SIZE=10

# Pin tested OpenRemote image tags before production deployment.
OPENREMOTE_PROXY_VERSION=latest
OPENREMOTE_POSTGRESQL_VERSION=latest-slim
OPENREMOTE_KEYCLOAK_VERSION=latest
OPENREMOTE_MANAGER_VERSION=latest
